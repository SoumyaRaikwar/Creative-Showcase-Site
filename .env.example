# ---------------------------------------------------------------------------
# Frontend (artifacts/portfolio) — build-time only
# ---------------------------------------------------------------------------
PORT=3000
BASE_PATH=/

# ---------------------------------------------------------------------------
# API server (artifacts/api-server) — Render
# ---------------------------------------------------------------------------
PORT=8080
NODE_ENV=production

# Optional. Stores contact messages in Postgres (Neon) in addition to emailing.
# Leave unset and messages are emailed only.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Email provider: "gmail" | "resend" | "auto" (auto = Resend if key set, else Gmail)
EMAIL_PROVIDER=auto

# Gmail SMTP (App Password, not your account password:
# Google Account → Security → 2-Step Verification → App passwords)
GMAIL_USER=somuraik@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Resend (optional alternative)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where contact-form notifications are delivered
NOTIFY_EMAIL=somuraik@gmail.com

# GitHub (read-only). A fine-grained PAT with no repo permissions is enough for
# public data. Required only for the contribution calendar; merged PRs work
# without it at a lower rate limit.
GITHUB_USER=SoumyaRaikwar
GITHUB_TOKEN=

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=https://soumyaraikwar.co.in,https://www.soumyaraikwar.co.in,http://localhost:3000
